<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tv_titre_xx"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/titre_formulaire"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <EditText
            android:id="@+id/et_nom_xx"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_nom"
            android:inputType="textPersonName" />

        <EditText
            android:id="@+id/et_naissance_xx"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_naissance"
            android:inputType="number"
            android:maxLength="4" />

        <EditText
            android:id="@+id/et_destination_xx"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_destination"
            android:inputType="number"
            android:maxLength="4" />

        <TextView
            android:id="@+id/tv_label_motif_xx"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/label_motif"
            android:textSize="16sp" />

        <RadioGroup
            android:id="@+id/rg_motif_xx"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/rb_tourisme_xx"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/motif_tourisme" />

            <RadioButton
                android:id="@+id/rb_modif_passe_xx"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/motif_modif_passe" />

            <RadioButton
                android:id="@+id/rb_fuite_xx"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/motif_fuite" />
        </RadioGroup>

        <Button
            android:id="@+id/btn_inspecter_xx"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/btn_inspecter" />
    </LinearLayout>
</ScrollView>